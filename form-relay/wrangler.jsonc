// EDF form relay (src/index.js). Deploy from this folder: `npx wrangler deploy`.
// Two secrets are not in this file (the repo is public): set each once, from this folder, with
//   npx wrangler secret put TURNSTILE_SECRET   (Turnstile's Secret Key)
//   npx wrangler secret put MAIL_TO            (the address messages go to: Jim's verified Gmail)
{
  "name": "edf-forms",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  // Served at https://edf-forms.<your workers.dev name>.workers.dev
  "workers_dev": true,
  // No extra per-version preview addresses: the one above is all the forms use.
  "preview_urls": false,
  // Email Routing. Cloudflare only delivers to verified destination addresses (Jim's Gmail is the
  // only one), and the Worker only ever sends to MAIL_TO, so the address stays out of this file.
  "send_email": [{ "name": "EMAIL" }],
  "vars": {
    // Must be an address on the forms subdomain (Email Routing → Settings → Subdomains → "forms").
    "FROM_ADDRESS": "website@forms.enrightdesignfoundry.com",
    "FROM_NAME": "EDF website",
    // The pages allowed to post (the live site, and the dev server for testing).
    "ALLOWED_ORIGINS": "https://enrightdesignfoundry.com,https://www.enrightdesignfoundry.com,http://localhost:5173"
  },
  // No request logs kept by Cloudflare for this Worker (it never logs messages itself either).
  "observability": { "enabled": false }
}
